  m_Script: {fileID: 11500000, guid: 432c34e160184294aa069e66d80c10c2, type: 3}
  m_Name: BossDefeated
  m_EditorClassIdentifier: 
  displayText: "\u8FD9\u662F\u4E00\u4E2A\u6587\u672C\u6570\u636E\u5BF9\u8C61\uFF01"
  useContinuousDialogue: 1
  dialogueTextArray:
  - "???:\u6709\u4E24\u4E0B\u5B50\uFF0C\u6211\u5F88\u4E45\u6CA1\u6709\u6D3B\u52A8\u5F00\u7B4B\u9AA8\u4E86\u3002"
  - "\u4F60\uFF1A\u8FD8\u6CA1\u6709\u88AB\u51FB\u8D25\u5417\uFF0C\u8FD9\u662F\u4EC0\u4E48\u602A\u7269\u3002"
  - "???:\u4E0D\u8981\u7D27\u5F20\uFF0C\u6211\u4E0D\u4F1A\u6740\u4E86\u4F60\uFF0C\u6211\u53EA\u662F\u5F85\u5728\u8FD9\u91CC\uFF0C\u7B49\u5F85\u6218\u4E2A\u75DB\u5FEB\u800C\u5DF2"
  - "\u5E7D\u7075:\u5979\u4F9D\u65E7\u5F3A\u7684\u53EF\u6015\u5462\uFF0C\u4E0D\u8981\u62C5\u5FC3\uFF0C\u5979\u786E\u5B9E\u4E0D\u4F1A\u6740\u4F60\uFF0C\u5B83\u662F\u8FD9\u91CC\u7684\u5BA1\u5224\u8005\uFF0C\u4F60\u5DF2\u7ECF\u5F97\u5230\u5979\u7684\u8BA4\u53EF\uFF0C\u53EF\u4EE5\u7EE7\u7EED\u524D\u8FDB\u4E86"
  - "???:\u4F60\u662F\u4E4B\u524D\u6765\u7684\u90A3\u4E2A\u5BB6\u4F19\u5417\uFF0C\u6B7B\u5728\u540E\u9762\u7684\u8DEF\u4E0A\u4E86\u5417"
  - "\u4F60:\u4F60\u66FE\u7ECF\u4E5F\u548C\u6211\u4E00\u6837\u6765\u5230\u4E86\u8FD9\u91CC\u5417"
  - "\u5E7D\u7075:\u6CA1\u9519\uFF0C\u6211\u662F\u4E0A\u4E00\u4E2A\u5192\u9669\u8005\uFF0C\u6216\u8005\u8BF4\uFF0C\u6211\u662F\u4E0A\u4E00\u4E2A\u4F60\u3002"
  - ......
  - "\u6211\u6700\u7EC8\u5012\u5728\u4E86\u9ECE\u660E\u524D\u591C\uFF0C\u56E0\u6B64\u6211\u5E0C\u671B\u4F60\u80FD\u5B8C\u6210\u8FD9\u4E00\u58EE\u4E3E"
  - "\u7A76\u7ADF\u662F\u600E\u4E48\u56DE\u4E8B"
  displayTime: 3
