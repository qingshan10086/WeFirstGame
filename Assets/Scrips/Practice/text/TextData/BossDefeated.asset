  m_Script: {fileID: 11500000, guid: 432c34e160184294aa069e66d80c10c2, type: 3}
  m_Name: BossDefeated
  m_EditorClassIdentifier: 
  displayText: "\u8FD9\u662F\u4E00\u4E2A\u6587\u672C\u6570\u636E\u5BF9\u8C61\uFF01"
  useContinuousDialogue: 1
  dialogueTextArray:
  - "???:\u6709\u4E24\u4E0B\u5B50\uFF0C\u6211\u5F88\u4E45\u6CA1\u6709\u6D3B\u52A8\u5F00\u7B4B\u9AA8\u4E86\u3002"
  - "\u4F60\uFF1A\u8FD8\u6CA1\u6709\u88AB\u51FB\u8D25\u5417\uFF0C\u8FD9\u662F\u4EC0\u4E48\u602A\u7269\u3002"
  - "\u5E7D\u7075\uFF1A\u4F60\u662F\u8C01\uFF0C\u4E3A\u4EC0\u4E48\u6211\u6709\u4E9B\u719F\u6089..."
  - "\uFF1F\uFF1F\uFF1F\uFF1A\u4F60\u662F...\u4E0A\u4E00\u6B21\u7684\u90A3\u4E2A\u6218\u58EB\u5417\uFF1F\u600E\u4E48\u6210\u8FD9\u6837\u4E86\u3002"
  - "\u5E7D\u7075\uFF1A\u4EC0\u4E48\uFF1F\u5934\u597D\u75DB..."
  - "\u4F60:\u4F60\u66FE\u7ECF\u4E5F\u548C\u6211\u4E00\u6837\u6765\u5230\u4E86\u8FD9\u91CC\u5417"
  - "???:\u662F\u7684\uFF0C\u8FD9\u91CC\u662F\u4E00\u573A\u8BD5\u70BC\uFF0C\u800C\u4ED6\u548C\u4F60\u4E00\u6837\u901A\u8FC7\u4E86\u8BD5\u70BC\uFF0C\u7EE7\u7EED\u5411\u524D\u5427\uFF01"
  - "\u5E7D\u7075\uFF1A\u554A\uFF0C\u6211\u60F3\u8D77\u6765\u4E86\u4E00\u90E8\u5206\uFF0C\u6709\u5173\u6211\u901A\u8FC7\u4E86\u8BD5\u70BC\uFF0C\u524D\u5F80\u6700\u6DF1\u5904\uFF0C\u4F46\u66F4\u591A\u7684\u6211\u8BB0\u4E0D\u8D77\u6765\u4E86"
  - "\u4F60\uFF1A\u90A3\u4E48\u524D\u8FDB\u5427\uFF0C\u5411\u7740\u4F60\u672A\u8D70\u5B8C\u7684\u8DEF"
  displayTime: 3
